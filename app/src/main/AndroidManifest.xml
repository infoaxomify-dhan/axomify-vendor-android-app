<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets a seller take a product-photo/KYC document directly from the
         file-upload fields already on the website, instead of only picking an
         existing file. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Required on Android 13+ before ANY notification can be shown —
         MainActivity.kt requests this at runtime; this just declares it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- v1.0.1 ADDED (2026-10-20) — needed so the sitewide "Axomify Location
         Gate" plugin's mandatory delivery-location popup (a SEPARATE plugin
         from Axomify Marketplace, runs on every front-end page for every
         visitor who has no location on file yet, including the Vendor
         Dashboard) can actually use its "Use My Location" button inside this
         app's WebView — see MainActivity.kt's requestRuntimePermissions() /
         onGeolocationPermissionsShowPrompt() for how it's granted. The
         Vendor Dashboard itself still has no live-location feature of its
         own — this is purely to support that other plugin's popup, same as
         how the Rider app already supports it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- v1.0.4 ADDED (2026-10-20) — "Phase 2" (owner-confirmed, real native
         order-siren via MediaPlayer, see AxomifyFirebaseMessagingService.kt's
         own v1.0.4 doc comment). Direct port of the Rider app's identical
         permissions: WAKE_LOCK lets playSirenDirectly() hold a brief partial
         wake lock so the siren clip is not cut off if the device tries to
         sleep mid-playback; FOREGROUND_SERVICE keeps a delivered push
         reliable even while Android is otherwise trying to doze the app —
         this does not keep the app process alive in the background beyond
         what FCM itself already guarantees. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:name=".AxomifyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AxomifyVendor"
        android:usesCleartextTraffic="false">

        <!-- The real app launcher — shows a full-screen custom splash image
             (see SplashActivity.kt + res/layout/activity_splash.xml). Hands
             off to MainActivity immediately, then finishes itself. -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AxomifyVendor.FullSplash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not the launcher (SplashActivity above is) — only ever started
             internally, by SplashActivity, so exported is false. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AxomifyVendor.Splash" />

        <!-- Handles every push the app receives, in every app state (foreground,
             background, and fully closed/killed) — see
             AxomifyFirebaseMessagingService.kt's v1.0.4 doc comment for why this
             is now the ONLY place a notification gets built/shown, and where the
             real native siren is played from. -->
        <service
            android:name=".AxomifyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default notification channel — kept in sync as a safe fallback in
             case a push is ever sent as a "notification"-type message instead of
             the normal data-only message. Must match AxomifyApplication.kt's
             CHANNEL_ID exactly. v1.0.4: bumped to the new silent siren channel
             id — a channel's sound/config is locked forever once created on a
             device, so this must always match whatever AxomifyApplication.kt
             currently creates. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="axomify_vendor_order_siren_v1" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/axomify_gold" />

    </application>
</manifest>
