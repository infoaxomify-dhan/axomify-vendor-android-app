<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AxomifyRider" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/axomify_gold</item>
        <item name="colorPrimaryDark">@color/axomify_ink</item>
        <item name="colorAccent">@color/axomify_gold</item>
        <item name="android:statusBarColor">@color/axomify_ink</item>
        <item name="android:windowBackground">@color/axomify_ink</item>
    </style>

    <!-- Brief splash while the WebView's first paint loads — avoids a flash of
         plain white before the page itself appears. Shows the Axomify Mart
         Rider logo centered on the brand-ink background (see drawable/
         splash_background.xml — that's the file to edit, not this one, for
         any future logo swap). Used by MainActivity, AFTER SplashActivity's
         own full-screen artwork (below) has already briefly shown. -->
    <style name="Theme.AxomifyRider.Splash" parent="Theme.AxomifyRider">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!-- v1.3.7 ADDED — SplashActivity's own theme. windowBackground is a plain
         solid color (not the full-screen image itself) so the very first frame
         Android draws, before activity_splash.xml's ImageView has even
         inflated, is never a jarring flash of plain white — it's a close
         enough color match to the artwork's own dark lower section. The actual
         full-screen artwork is drawn moments later by the ImageView in
         res/layout/activity_splash.xml (see SplashActivity.kt). -->
    <style name="Theme.AxomifyRider.FullSplash" parent="Theme.AxomifyRider">
        <item name="android:windowBackground">@color/axomify_ink</item>
    </style>
</resources>
